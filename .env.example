APP_NAME="prawkonaraz.pl"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Warsaw

CONTENT_ORGANIZATION_NAME="PrawkoNaRaz"
CONTENT_ORGANIZATION_LEGAL_NAME=
CONTENT_ORGANIZATION_ADDRESS=
CONTENT_ORGANIZATION_TAX_ID=
CONTENT_CONTACT_EMAIL=kontakt@prawkonaraz.pl
CONTENT_PRIVACY_EMAIL=kontakt@prawkonaraz.pl
CONTENT_ORGANIZATION_LOGO_URL="${APP_URL}/favicon.png"
CONTENT_ORGANIZATION_LOGO_WIDTH=256
CONTENT_ORGANIZATION_LOGO_HEIGHT=256
LEGAL_DOCUMENTS_EFFECTIVE_DATE=2026-09-04
LEGAL_TERMS_VERSION=2026-09-04
LEGAL_PRIVACY_VERSION=2026-09-04

INDEXNOW_ENABLED=false
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_HOST=prawkonaraz.pl
INDEXNOW_KEY=
INDEXNOW_KEY_SOURCE=
INDEXNOW_KEY_LOCATION=
INDEXNOW_TIMEOUT=10
INDEXNOW_MAX_URLS_PER_REQUEST=10000
INDEXNOW_AUTOMATION_ENABLED=false
INDEXNOW_QUEUE_BATCH_SIZE=50
INDEXNOW_QUEUE_DEBOUNCE_MINUTES=10
INDEXNOW_QUEUE_RETRY_MINUTES=60
QUESTION_RELATIONS_ENABLED=true
QUESTION_RELATIONS_MINIMUM_LINKS=15
QUESTION_RELATIONS_AUTOMATIC_SCORE_THRESHOLD=0.50
QUESTION_RELATIONS_INDEXABLE_TOPIC_MINIMUM=10
QUESTION_RELATIONS_V2_ENABLED=false
QUESTION_RELATIONS_V2_SHADOW_ENABLED=false
QUESTION_RELATIONS_V2_SHADOW_MONITOR_AT=04:00
QUESTION_RELATIONS_V2_CANARY_ENABLED=false
QUESTION_RELATIONS_V2_CANARY_MONITOR_AT=04:15

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_IDENTITY_ENABLED=false
GOOGLE_ONE_TAP_ENABLED=false
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_CONSENT_REQUIRED=true
GOOGLE_ANALYTICS_DEBUG_MODE=false
GOOGLE_ANALYTICS_COOKIE_FLAGS=SameSite=Lax;Secure

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

PAYMENT_PROVIDER=sandbox
PAYMENTS_SANDBOX_ENABLED=true

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
PERF_SMOKE_MAX_SESSION_START_MS=150
PERF_SMOKE_MAX_FIRST_ANSWER_MS=150
PERF_SMOKE_MAX_SESSION_COMPLETE_MS=150
PERF_SMOKE_MAX_DASHBOARD_MS=150
PUBLIC_AUTH_DRAWERS_LAZY=false
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_BASE_URL=https://ipapi.co
IP_GEOLOCATION_CONNECT_TIMEOUT=0.75
IP_GEOLOCATION_TIMEOUT=1.5
STUDY_COMPLETED_SESSION_RETENTION_DAYS=365
STUDY_ABANDONED_SESSION_RETENTION_DAYS=7
STUDY_ADMIN_ACTIVITY_WINDOW_DAYS=90
STUDY_QUESTION_ANALYTICS_WINDOW_DAYS=365
STUDY_QUESTION_DAILY_STATS_RETENTION_DAYS=365
QUESTION_MONTHLY_STATS_ROLLUP_AT=03:10
MONITORING_SNAPSHOT_AT=03:00
USER_IP_HISTORY_PRUNE_AT=03:05
STUDY_HISTORY_PRUNE_AT=03:20
SQLITE_OPTIMIZE_AT=03:35
SQLITE_VACUUM_AT=04:10
BACKUP_DISK=backup_local
# BACKUP_DISK options:
# - backup_local: lokalne kopie developerskie w storage/app/backup-local
# - r2: Cloudflare R2 / S3-compatible object storage
BACKUP_LOCAL_ROOT=
BACKUP_SCHEDULE_FREQUENCY=weekly
BACKUP_SCHEDULE_DAY_OF_WEEK=0
BACKUP_SCHEDULE_AT=02:15
HEALTH_BACKUP_MAX_AGE_HOURS=192

# Lokalny i produkcyjny kierunek to PostgreSQL + Redis.
# Domyslny start lokalny:
# docker compose up -d --build
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=prawkobit
DB_USERNAME=prawkobit
DB_PASSWORD=prawkobit
DB_SSLMODE=prefer
# Fallback dla lekkiego debugu i testowych eksperymentow jest opisany w `.env.sqlite.example`.

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_PUBLIC_DISK=public
MEDIA_PUBLIC_BASE_URL=
MEDIA_LOCAL_ROOT=
MEDIA_LOCAL_HOST_ROOT=
MEDIA_LOCAL_URL=
MEDIA_LOCAL_LINK=storage-bulk
MEDIA_FFMPEG_BINARY=ffmpeg
MEDIA_IMAGE_THUMB_WIDTH=480
MEDIA_IMAGE_WEBP_QUALITY=72
QUEUE_CONNECTION=sync

PWA_PURCHASE_MODE=web
TWA_PACKAGE_NAME=pl.prawkonaraz.app
TWA_SHA256_CERT_FINGERPRINTS=

CACHE_STORE=redis
# CACHE_PREFIX=
RANKED_PRESENCE_STORE=redis
RANKED_PRESENCE_KEY_PREFIX=ranked:presence
RANKED_PRESENCE_TTL_SECONDS=90
RANKED_SSE_ENABLED=true
RANKED_SSE_RETRY_MS=2000
RANKED_WEBSOCKET_ENABLED=false
RANKED_WEBSOCKET_URL=
RANKED_WEBSOCKET_HOST=0.0.0.0
RANKED_WEBSOCKET_PORT=8080
RANKED_WEBSOCKET_PATH=/ranked
RANKED_WEBSOCKET_PUBLISH_INTERVAL_MS=1000
RANKED_WEBSOCKET_TICKET_STORE=
RANKED_WEBSOCKET_TICKET_KEY_PREFIX=ranked:websocket-ticket
RANKED_WEBSOCKET_TICKET_TTL_SECONDS=180

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_CACHE_CONNECTION=cache

DOCKER_PG_DATABASE=prawkobit
DOCKER_PG_USERNAME=prawkobit
DOCKER_PG_PASSWORD=prawkobit

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
# Example: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional public/custom URL if you expose the bucket through a domain
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
