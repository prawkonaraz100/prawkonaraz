APP_NAME="prawkobit.pl"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Warsaw

CONTENT_ORGANIZATION_NAME="PrawkoNaRaz"
CONTENT_ORGANIZATION_LEGAL_NAME=
CONTENT_CONTACT_EMAIL=kontakt@prawkonaraz.pl
CONTENT_ORGANIZATION_LOGO_URL="${APP_URL}/favicon.png"
CONTENT_ORGANIZATION_LOGO_WIDTH=256
CONTENT_ORGANIZATION_LOGO_HEIGHT=256

INDEXNOW_ENABLED=false
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_HOST=prawkonaraz.pl
INDEXNOW_KEY=
INDEXNOW_KEY_SOURCE=
INDEXNOW_KEY_LOCATION=
INDEXNOW_TIMEOUT=10
INDEXNOW_MAX_URLS_PER_REQUEST=10000
INDEXNOW_AUTOMATION_ENABLED=false
INDEXNOW_QUEUE_BATCH_SIZE=50
INDEXNOW_QUEUE_DEBOUNCE_MINUTES=10
INDEXNOW_QUEUE_RETRY_MINUTES=60

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_BASE_URL=https://ipapi.co
IP_GEOLOCATION_CONNECT_TIMEOUT=0.75
IP_GEOLOCATION_TIMEOUT=1.5

STUDY_COMPLETED_SESSION_RETENTION_DAYS=365
STUDY_ABANDONED_SESSION_RETENTION_DAYS=7
STUDY_ADMIN_ACTIVITY_WINDOW_DAYS=90
STUDY_QUESTION_ANALYTICS_WINDOW_DAYS=365
STUDY_QUESTION_DAILY_STATS_RETENTION_DAYS=365
QUESTION_MONTHLY_STATS_ROLLUP_AT=03:10
MONITORING_SNAPSHOT_AT=03:00
USER_IP_HISTORY_PRUNE_AT=03:05
STUDY_HISTORY_PRUNE_AT=03:20

BACKUP_DISK=backup_local
BACKUP_LOCAL_ROOT=
BACKUP_SCHEDULE_FREQUENCY=weekly
BACKUP_SCHEDULE_DAY_OF_WEEK=0
BACKUP_SCHEDULE_AT=02:15
HEALTH_BACKUP_MAX_AGE_HOURS=192

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=media_local
MEDIA_PUBLIC_DISK=media_local
MEDIA_UPLOAD_DISK=media_local
MEDIA_NEWSROOM_DISK=media_local
MEDIA_NEWSROOM_PREFIX=newsroom/articles
MEDIA_NEWSROOM_MAX_DIMENSION=10000
MEDIA_LOCAL_ROOT=D:/datasets/mi-prawo-jazdy-2026/app-media
MEDIA_LOCAL_HOST_ROOT=D:/datasets/mi-prawo-jazdy-2026/app-media
MEDIA_LOCAL_URL=http://127.0.0.1:8081
MEDIA_LOCAL_LINK=storage-bulk
MEDIA_FFMPEG_BINARY=ffmpeg
MEDIA_IMAGE_THUMB_WIDTH=480
MEDIA_IMAGE_WEBP_QUALITY=72

QUEUE_CONNECTION=sync

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
